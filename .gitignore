# Python bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local environments and credentials
.venv/
venv/
env/
.env
.env.*
!.env.example

# Build and coverage output
build/
dist/
*.egg-info/
.coverage
.coverage.*
htmlcov/

# Editor settings, local backups and temporary files
.vscode/
.idea/
.backups/
*.swp
*.swo
*~
*.tmp
*.log
.DS_Store

# Local model downloads and large profiling artifacts
/models/
/checkpoints/
/profiler_traces/
*.nsys-rep
*.ncu-rep

# Model directories written by save_model(): regenerable, not source
step*/my_*_model/
step*/*.safetensors

# Keep benchmarks/results/*.json tracked as reproducible experiment records.

# Profiler traces: large (up to 8 MB) and regenerable via profile_step36.py.
# Keep only the two curated representative traces for step36; the rest stay local.
benchmarks/results/step36_traces/*
!benchmarks/results/step36_traces/mine_prefill_c8.pt.trace.json.gz
!benchmarks/results/step36_traces/vllm_prefill_c8.pt.trace.json.gz
