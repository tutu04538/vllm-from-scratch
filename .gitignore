# Python bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local environments and credentials
.venv/
venv/
env/
.env
.env.*
!.env.example

# Build and coverage output
build/
dist/
*.egg-info/
.coverage
.coverage.*
htmlcov/

# Local agent instructions: 只在本机用，不进版本控制
AGENTS.md
CLAUDE.md

# Editor settings, local backups and temporary files
.vscode/
.idea/
.backups/
*.swp
*.swo
*~
*.tmp
*.log
.DS_Store

# Local model downloads and large profiling artifacts
/models/
/checkpoints/
/profiler_traces/
*.nsys-rep
*.ncu-rep

# Local model dirs: tiny test models are generated on demand (see minivllm/testing/tiny_models.py)
/fixtures/

# Model directories written by tests/save_model(): regenerable, not source
minivllm/my_*_model/
minivllm/*.safetensors

# Benchmark results are local artifacts, not source: the scripts stay tracked
# (benchmarks/check_*.py 是回归测试), only their output is ignored.
benchmarks/results/
benchmarks/**/*.json
benchmarks/**/*.pt.trace.json.gz

# 本地工作目录：上游 vLLM 疑似 BUG 清单 + 复现脚本（给验证方 agent 的任务单，只在本机，不提交）
vllm_bugs/
